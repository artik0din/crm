# Postgres credentials. Use the same password in DATABASE_URL.
POSTGRES_PASSWORD="replace-with-a-long-random-password"
DATABASE_URL="postgresql://postgres:replace-with-a-long-random-password@postgres:5432/crm?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Comma-separated email domains or individual addresses allowed to sign in.
ALLOWED_SIGN_IN=""

# Google OAuth credentials. Set both or leave both empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public origins for the API and web app.
API_URL="https://crm-api.payrolless.co"
APP_URL="https://crm.payrolless.co"
AUTH_COOKIE_DOMAIN=".payrolless.co"

# Internal Redis cache.
REDIS_URL="redis://redis:6379"

# Generate each secret independently with: openssl rand -base64 32
CRON_SECRET=""
AGENT_BRIDGE_SECRET=""

# Required only when the optional Eve agent profile runs outside Vercel.
AI_GATEWAY_API_KEY=""

# Disable anonymous product telemetry.
CRM_TELEMETRY_DISABLED="1"

# Loopback ports used by nginx.
APP_PORT="5800"
API_PORT="5801"

# Dedicated Docker subnet. Change it when this range overlaps another network.
DOCKER_SUBNET="172.16.47.0/24"
